{
  "name": "context-sync",
  "displayName": "Context Sync for Claude Code",
  "description": "Keep Claude Code memory and the chats you pick in a private git repo you own. Continue chats on any machine, and share a project's memory with your team, with owner review.",
  "version": "1.0.0",
  "publisher": "prathameshppawar",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1020",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Prathameshppawar/claude-context-sync.git"
  },
  "homepage": "https://github.com/Prathameshppawar/claude-context-sync#readme",
  "bugs": {
    "url": "https://github.com/Prathameshppawar/claude-context-sync/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "memory",
    "context",
    "chat history",
    "sync",
    "multi-device",
    "team",
    "git",
    "backup"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node test/unit.js && node test/e2e.js && node test/team.js",
    "package": "npx --yes @vscode/vsce@3.2.1 package --no-dependencies",
    "package:local": "npx --yes @vscode/vsce@3.2.1 package --no-dependencies --allow-missing-repository --skip-license --no-rewrite-relative-links"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeContext",
          "title": "Context Sync",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeContext": [
        {
          "id": "claudeContext.chats",
          "name": "Chats"
        },
        {
          "id": "claudeContext.team",
          "name": "Team"
        },
        {
          "id": "claudeContext.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeContext.chats",
        "contents": "Keep Claude's memory and the chats you pick in a private git repo, so every machine you work on has them.\n[Set up](command:claudeContext.setup)\n[See what it does and how it works](command:claudeContext.openHome)",
        "when": "!claudeContext.repoReady"
      },
      {
        "view": "claudeContext.chats",
        "contents": "Your context repo is on this machine, but sync isn't on for this folder yet.\n[Turn on sync for this folder](command:claudeContext.enableProject)\n[See what it does and how it works](command:claudeContext.openHome)",
        "when": "claudeContext.repoReady && !claudeContext.hasPersonal"
      },
      {
        "view": "claudeContext.projects",
        "contents": "Set up a context repo first.\n[Set up](command:claudeContext.setup)\n[See what it does and how it works](command:claudeContext.openHome)",
        "when": "!claudeContext.repoReady"
      },
      {
        "view": "claudeContext.team",
        "contents": "Share one project's memory with your team without exposing your other projects or private notes. What teammates add waits for your review before it reaches anyone.\n[Create a team repo](command:claudeContext.createTeam)\n[Join a team repo](command:claudeContext.joinTeam)",
        "when": "!claudeContext.hasTeams"
      }
    ],
    "commands": [
      {
        "command": "claudeContext.openHome",
        "title": "Open Home",
        "category": "Context Sync",
        "icon": "$(home)"
      },
      {
        "command": "claudeContext.syncNow",
        "title": "Sync Now",
        "category": "Context Sync",
        "icon": "$(sync)"
      },
      {
        "command": "claudeContext.syncCurrentChat",
        "title": "Sync Current Chat",
        "category": "Context Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "claudeContext.pickChats",
        "title": "Pick Chats to Sync…",
        "category": "Context Sync",
        "icon": "$(checklist)"
      },
      {
        "command": "claudeContext.pullChat",
        "title": "Pull",
        "category": "Context Sync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeContext.resumeChat",
        "title": "Resume in Claude",
        "category": "Context Sync",
        "icon": "$(play)"
      },
      {
        "command": "claudeContext.copyChatId",
        "title": "Copy Chat ID",
        "category": "Context Sync"
      },
      {
        "command": "claudeContext.revealChat",
        "title": "Reveal Chat File",
        "category": "Context Sync"
      },
      {
        "command": "claudeContext.enableProject",
        "title": "Turn On Sync for This Project",
        "category": "Context Sync",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "claudeContext.enableAllProjects",
        "title": "Turn On Sync for All Projects",
        "category": "Context Sync",
        "icon": "$(cloud)"
      },
      {
        "command": "claudeContext.setup",
        "title": "Set Up…",
        "category": "Context Sync"
      },
      {
        "command": "claudeContext.showNotices",
        "title": "Show Sync Problems",
        "category": "Context Sync"
      },
      {
        "command": "claudeContext.showLog",
        "title": "Open Sync Log",
        "category": "Context Sync"
      },
      {
        "command": "claudeContext.openRepo",
        "title": "Open Context Repo",
        "category": "Context Sync",
        "icon": "$(github)"
      },
      {
        "command": "claudeContext.refresh",
        "title": "Refresh",
        "category": "Context Sync",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeContext.createTeam",
        "title": "Create a Team Repo for This Project",
        "category": "Context Sync",
        "icon": "$(organization)"
      },
      {
        "command": "claudeContext.joinTeam",
        "title": "Join a Team Repo",
        "category": "Context Sync",
        "icon": "$(cloud-download)"
      },
      {
        "command": "claudeContext.shareWithTeam",
        "title": "Share With a Team…",
        "category": "Context Sync",
        "icon": "$(organization)"
      },
      {
        "command": "claudeContext.reviewDiff",
        "title": "Compare",
        "category": "Context Sync",
        "icon": "$(diff)"
      },
      {
        "command": "claudeContext.reviewAccept",
        "title": "Accept",
        "category": "Context Sync",
        "icon": "$(check)"
      },
      {
        "command": "claudeContext.reviewReject",
        "title": "Reject",
        "category": "Context Sync",
        "icon": "$(close)"
      },
      {
        "command": "claudeContext.reviewMerge",
        "title": "Merge With Claude",
        "category": "Context Sync",
        "icon": "$(sparkle)"
      },
      {
        "command": "claudeContext.reviewAcceptAll",
        "title": "Accept All",
        "category": "Context Sync",
        "icon": "$(check-all)"
      },
      {
        "command": "claudeContext.openTeamOnGitHub",
        "title": "Open on GitHub",
        "category": "Context Sync",
        "icon": "$(github)"
      },
      {
        "command": "claudeContext.acceptMerged",
        "title": "Accept Merged Version",
        "category": "Context Sync",
        "icon": "$(check)"
      },
      {
        "command": "claudeContext.discardMerged",
        "title": "Discard Merged Version",
        "category": "Context Sync",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeContext.openHome",
          "when": "view == claudeContext.chats",
          "group": "navigation@0"
        },
        {
          "command": "claudeContext.syncNow",
          "when": "view == claudeContext.chats && claudeContext.configured",
          "group": "navigation@1"
        },
        {
          "command": "claudeContext.pickChats",
          "when": "view == claudeContext.chats && claudeContext.configured",
          "group": "navigation@2"
        },
        {
          "command": "claudeContext.refresh",
          "when": "view == claudeContext.chats",
          "group": "navigation@3"
        },
        {
          "command": "claudeContext.syncCurrentChat",
          "when": "view == claudeContext.chats && claudeContext.configured",
          "group": "9_more@1"
        },
        {
          "command": "claudeContext.openRepo",
          "when": "view == claudeContext.chats && claudeContext.configured",
          "group": "9_more@2"
        },
        {
          "command": "claudeContext.showLog",
          "when": "view == claudeContext.chats && claudeContext.configured",
          "group": "9_more@3"
        },
        {
          "command": "claudeContext.enableAllProjects",
          "when": "view == claudeContext.projects && claudeContext.repoReady",
          "group": "navigation@1"
        },
        {
          "command": "claudeContext.refresh",
          "when": "view == claudeContext.projects",
          "group": "navigation@2"
        },
        {
          "command": "claudeContext.createTeam",
          "when": "view == claudeContext.team",
          "group": "navigation@1"
        },
        {
          "command": "claudeContext.joinTeam",
          "when": "view == claudeContext.team",
          "group": "navigation@2"
        },
        {
          "command": "claudeContext.refresh",
          "when": "view == claudeContext.team",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeContext.resumeChat",
          "when": "view == claudeContext.chats && viewItem =~ /\\blocal\\b/",
          "group": "inline@1"
        },
        {
          "command": "claudeContext.pullChat",
          "when": "view == claudeContext.chats && viewItem =~ /\\b(incoming|remote-only)\\b/",
          "group": "inline@2"
        },
        {
          "command": "claudeContext.resumeChat",
          "when": "view == claudeContext.chats && viewItem =~ /\\blocal\\b/",
          "group": "1_open@1"
        },
        {
          "command": "claudeContext.pullChat",
          "when": "view == claudeContext.chats && viewItem =~ /\\b(incoming|remote-only)\\b/",
          "group": "1_open@2"
        },
        {
          "command": "claudeContext.copyChatId",
          "when": "view == claudeContext.chats && viewItem =~ /\\bchat\\b/",
          "group": "2_info@1"
        },
        {
          "command": "claudeContext.revealChat",
          "when": "view == claudeContext.chats && viewItem =~ /\\blocal\\b/",
          "group": "2_info@2"
        },
        {
          "command": "claudeContext.enableProject",
          "when": "view == claudeContext.projects && viewItem =~ /nopersonal .* exists/",
          "group": "inline"
        },
        {
          "command": "claudeContext.shareWithTeam",
          "when": "view == claudeContext.projects && viewItem =~ /noteam exists/",
          "group": "inline"
        },
        {
          "command": "claudeContext.reviewMerge",
          "when": "view == claudeContext.team && viewItem =~ /^change owner (added|modified)/",
          "group": "inline@1"
        },
        {
          "command": "claudeContext.reviewAccept",
          "when": "view == claudeContext.team && viewItem =~ /^change owner/",
          "group": "inline@2"
        },
        {
          "command": "claudeContext.reviewReject",
          "when": "view == claudeContext.team && viewItem =~ /^change owner/",
          "group": "inline@3"
        },
        {
          "command": "claudeContext.reviewDiff",
          "when": "view == claudeContext.team && viewItem =~ /^change/",
          "group": "1_review@1"
        },
        {
          "command": "claudeContext.reviewMerge",
          "when": "view == claudeContext.team && viewItem =~ /^change owner (added|modified)/",
          "group": "1_review@2"
        },
        {
          "command": "claudeContext.reviewAccept",
          "when": "view == claudeContext.team && viewItem =~ /^change owner/",
          "group": "1_review@3"
        },
        {
          "command": "claudeContext.reviewReject",
          "when": "view == claudeContext.team && viewItem =~ /^change owner/",
          "group": "1_review@4"
        },
        {
          "command": "claudeContext.reviewAcceptAll",
          "when": "view == claudeContext.team && viewItem =~ /^teammate pending/",
          "group": "inline@1"
        },
        {
          "command": "claudeContext.openTeamOnGitHub",
          "when": "view == claudeContext.team && viewItem =~ /^(teammate|teamrepo)/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeContext.pullChat",
          "when": "false"
        },
        {
          "command": "claudeContext.resumeChat",
          "when": "false"
        },
        {
          "command": "claudeContext.copyChatId",
          "when": "false"
        },
        {
          "command": "claudeContext.revealChat",
          "when": "false"
        },
        {
          "command": "claudeContext.reviewDiff",
          "when": "false"
        },
        {
          "command": "claudeContext.reviewAccept",
          "when": "false"
        },
        {
          "command": "claudeContext.reviewReject",
          "when": "false"
        },
        {
          "command": "claudeContext.reviewMerge",
          "when": "false"
        },
        {
          "command": "claudeContext.reviewAcceptAll",
          "when": "false"
        },
        {
          "command": "claudeContext.openTeamOnGitHub",
          "when": "false"
        },
        {
          "command": "claudeContext.acceptMerged",
          "when": "claudeContext.mergeActive"
        },
        {
          "command": "claudeContext.discardMerged",
          "when": "claudeContext.mergeActive"
        }
      ],
      "editor/title": [
        {
          "command": "claudeContext.acceptMerged",
          "when": "claudeContext.mergeActive",
          "group": "navigation@1"
        },
        {
          "command": "claudeContext.discardMerged",
          "when": "claudeContext.mergeActive",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Context Sync",
      "properties": {
        "claudeContext.repoPath": {
          "type": "string",
          "default": "",
          "description": "Folder of your personal context repo. Empty means ~/claude-context."
        },
        "claudeContext.pullIntervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "How often to pull memory and chats from your other machines while VS Code is open. 0 turns it off (Claude sessions still pull when they start)."
        },
        "claudeContext.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node used to run the sync tool. Empty means VS Code's own runtime."
        },
        "claudeContext.claudePath": {
          "type": "string",
          "default": "",
          "description": "Claude Code executable used for Merge With Claude. Empty means the one inside the Claude Code extension, then claude on PATH."
        },
        "claudeContext.mergeModel": {
          "type": "string",
          "default": "sonnet",
          "description": "Model Merge With Claude uses (passed to claude --model)."
        }
      }
    }
  }
}
